# OpenAI-compatible embedding endpoint used by BOTH the offline build and the
# read-only MCP servers. It must be reachable from Docker containers on this host.
EMBEDDING_PROVIDER=OpenAI
EMBEDDING_MODEL=your-embedding-model-id
OPENAI_BASE_URL=http://your-embedding-host:8080/v1
OPENAI_API_KEY=placeholder-or-real-key
# Optional, serve side only: instruction prefixed to search queries for
# instruction-tuned embedding models (sent as "Instruct: <this>\nQuery:<query>").
# Documents are embedded without it, so changing it needs no rebuild, only `coderag.sh serve`.
# Example for Qwen3-Embedding:
# CODERAG_QUERY_INSTRUCTION=Given a question about a codebase, retrieve the code snippets that answer it
