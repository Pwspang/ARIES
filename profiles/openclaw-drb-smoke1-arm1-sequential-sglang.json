{
  "name": "openclaw-drb-smoke1-arm1-sequential-sglang",
  "versions_file": "../configs/versions.json",
  "overrides_file": "",
  "execution": {
    "concurrency": 1
  },
  "benchmark": {
    "type": "deepresearchbench",
    "root": ".cache/deep-research-bench",
    "tasks": [
      "1"
    ],
    "environment": {
      "image": "ihasfarm/aries-deepresearchbench:latest",
      "workdir": "/workspace"
    },
    "judge": {
      "provider": "deepseek",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "model": "deepseek-v4-flash"
    },
    "fact": {
      "jina_api_key_env": "JINA_API_KEY"
    },
    "structured_subtasks": {
      "planset_dir": "plansets/smoke1-v1",
      "order": "sequential"
    }
  },
  "harness": {
    "type": "openclaw",
    "web_search": {
      "enabled": true,
      "extract_api_key_env": "TAVILY_API_KEY"
    },
    "subagents": {
      "enabled": false
    }
  },
  "sandbox": {
    "type": "docker"
  },
  "bridge": {
    "type": "openclaw-ssh"
  },
  "runtime": {
    "backend": "sglang",
    "mode": "external",
    "config": {
      "file": "../configs/sglang/qwen3.6-35b-local.yaml"
    }
  },
  "model": {
    "base_url": "http://192.168.0.77:8100/v1",
    "api_key_env": "SGLANG_API_KEY",
    "id": "Qwen/Qwen3.6-35B-A3B-FP8"
  },
  "output_dir": "runs"
}
